# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings > API
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY   # server-only secret

# Family passcode everyone types to get in. Use 8+ characters.
FAMILY_PASSCODE=CHOOSE_A_PASSCODE
# Any long random string (changing it logs everyone out)
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Weather fallback if a device blocks location access (kept on the server, never sent to the page before sign-in)
HOME_LAT=40.7128
HOME_LON=-74.0060


